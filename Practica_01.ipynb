      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Creación del array original\n",
        "original = np.arange(1, 10).reshape(3, 3)\n",
        "\n",
        "# Creación de una vista y una copia independiente\n",
        "vista = original[:2, :2]\n",
        "copia = original[:2, :2].copy()\n",
        "\n",
        "print(\"Matriz original antes de las modificaciones:\")\n",
        "print(original)\n",
        "\n",
        "\n",
        "# Modificación de la vista\n",
