        "# Función básica\n",
        "def saludar(nombre):\n",
        "  return f'Hola, {nombre}!'\n",
        "# Con parámetros por defecto\n",
        "def potencia(base, exponente=2):\n",
        "  '''Eleva base a exponente. Por defecto calcula el cuadrado.'''\n",
        "  return base ** exponente\n",
        "print(potencia(5)) # 25 (usa exponente=2 por defecto)\n",
        "print(potencia(2, 10)) # 1024\n",
        "# Retorno múltiple (devuelve una tupla)\n",
        "def min_max(lista):\n",
        "  return min(lista), max(lista) # empaqueta como tupla\n",
        "minimo, maximo = min_max([3,1,7,2,5]) # desempaqueta\n",
        "print(minimo, maximo) # 1 7\n",
        "# Lambda — función anónima\n",
        "doble = lambda x: x * 2\n",
        "print(doble(8)) # 16\n",
        "# Útil como argumento en funciones de orden superior\n",
        "nums = [5, 2, 8, 1, 9, 3]\n",
        "ordenados = sorted(nums, key=lambda x: -x) # orden descendente\n",
        "# [9, 8, 5, 3, 2, 1]\n",
        "# map y filter\n",
        "cuadrados = list(map(lambda x: x**2, nums))\n",
        "mayores = list(filter(lambda x: x > 4, nums))"
      ],
