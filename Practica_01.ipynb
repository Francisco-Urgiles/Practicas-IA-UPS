        "# Definición de la función de resumen\n",
        "def resumen(lista):\n",
        "    return {\n",
        "        'longitud': len(lista),\n",
        "        'suma': sum(lista),\n",
        "        'promedio': sum(lista) / len(lista),\n",
        "        'minimo': min(lista),\n",
        "        'maximo': max(lista)\n",
        "    }\n",
        "\n",
        "\n",
        "# Aplicación de la función\n",
        "lista_ejemplo = [3, 1, 7, 2, 5]\n",
        "\n",
        "resultado_resumen = resumen(lista_ejemplo)\n",
        "\n",
        "# Presentación de resultados\n",
        "print(\"Lista analizada:\", lista_ejemplo)\n",
        "\n",
        "for clave, valor in resultado_resumen.items():\n",
        "    print(f\"{clave.capitalize():12s}: {valor}\")"
