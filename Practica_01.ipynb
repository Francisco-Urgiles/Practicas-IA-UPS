    {
      "cell_type": "code",
      "source": [
        "# Datos de entrada\n",
        "datos = {'a': 10, 'b': 25, 'c': 7, 'd': 18}\n",
        "\n",
        "# a) Selección de claves cuyo valor es mayor a 12\n",
        "claves_filtradas = [\n",
        "    clave for clave, valor in datos.items()\n",
        "    if valor > 12\n",
        "]\n",
        "\n",
        "# b) Creación de un diccionario con valores al cuadrado\n",
        "datos_cuadrados = {\n",
        "    clave: datos[clave] ** 2\n",
        "    for clave in claves_filtradas\n",
        "}\n",
        "\n",
        "# Presentación de resultados\n",
        "print(\"Diccionario original:\", datos)\n",
        "print(\"Claves con valores mayores a 12:\", claves_filtradas)\n",
        "print(\"Diccionario con valores al cuadrado:\", datos_cuadrados)"
