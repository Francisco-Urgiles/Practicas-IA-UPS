      "cell_type": "code",
      "source": [
        "# Creación de listas\n",
        "numeros = [10, 20, 30, 40, 50]\n",
        "mixta = [1, 'texto', 3.14, True] # tipos heterogéneos\n",
        "vacia = []\n",
        "de_rango = list(range(1, 11)) # [1, 2, 3, ..., 10]\n",
        "# Acceso por índice\n",
        "print(numeros[0]) # 10 → primer elemento\n",
        "print(numeros[-1]) # 50 → último elemento\n",
        "print(numeros[-2]) # 40 → penúltimo\n",
        "# Slicing [inicio : fin : paso]\n",
        "# 'fin' es EXCLUIDO — el rango es [inicio, fin)\n",
        "print(\"índices 1,2,3\")\n",
        "print(numeros[1:4]) # [20, 30, 40] índices 1,2,3\n",
        "print(\"desde el inicio hasta índice 2\")\n",
        "print(numeros[:3]) # [10, 20, 30] desde el inicio hasta índice 2\n",
        "print(\"desde índice 2 hasta el final\")\n",
        "print(numeros[2:]) # [30, 40, 50] desde índice 2 hasta el final\n",
        "print(\"cada 2 elementos\")\n",
        "print(numeros[::2]) # [10, 30, 50] cada 2 elementos\n",
        "print(\"invertida\")\n",
        "print(numeros[::-1]) # [50, 40, 30, 20, 10] invertida\n",
        "# Métodos principales\n",
        "numeros.append(60) # agrega al final → O(1)\n",
        "numeros.insert(2, 99) # inserta en posición 2 → O(n)\n",
        "numeros.remove(99) # elimina primera ocurrencia\n",
        "ultimo = numeros.pop() # extrae y devuelve el último elemento\n",
        "print(len(numeros)) # longitud de la lista"
      ],
