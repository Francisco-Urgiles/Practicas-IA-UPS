        ")\n",
        "\n",
        "print(\"Concatenación horizontal:\")\n",
        "print(resultado_horizontal)\n",
        "print(\"Shape:\", resultado_horizontal.shape)\n",
        "\n",
        "\n",
        "# División del resultado vertical en tres partes\n",
        "partes = np.vsplit(resultado_vertical, 3)\n",
        "\n",
        "print(\"División vertical en tres partes iguales:\")\n",
        "\n",
        "for i, parte in enumerate(partes, start=1):\n",
        "    print(f\"Parte {i}:\")\n",
        "    print(parte)\n",
        "    print(\"Shape:\", parte.shape)"
