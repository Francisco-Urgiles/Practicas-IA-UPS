        "\n",
        "# Comparación de resultados\n",
        "print(\"Vista modificada:\")\n",
        "print(vista)\n",
        "\n",
        "print(\"Copia modificada:\")\n",
        "print(copia)\n",
        "\n",
        "print(\"Matriz original después de las modificaciones:\")\n",
        "print(original)\n",
        "\n",
        "# Verificación de memoria compartida\n",
