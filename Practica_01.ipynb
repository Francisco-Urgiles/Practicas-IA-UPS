        "# Datos de estudiantes\n",
        "nombres = np.array([\n",
        "    'Carlos', 'Ana', 'Diana', 'Pedro', 'Eva', 'Luis'\n",
        "])\n",
        "\n",
        "notas = np.array([75, 92, 88, 61, 95, 78])\n",
        "\n",
        "\n",
        "# Cálculo del promedio general\n",
        "promedio_general = notas.mean()\n",
        "\n",
        "print(\"Notas:\", notas)\n",
        "print(\"Promedio general:\", promedio_general)\n",
        "\n",
        "\n",
        "# a) Máscara y cantidad de estudiantes sobre el promedio\n",
        "mascara_superior = notas > promedio_general\n",
